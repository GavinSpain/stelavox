# .env.example — copy to .env.local and fill in real values
# NEVER commit .env.local — it is gitignored

# Supabase — from `supabase start` (Phase A) or Supabase dashboard (Phase B/C)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API — server-side only, never expose to browser
ANTHROPIC_API_KEY=

# Security canary — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value for dev and production. See Technical Architecture v1.3 §4.4
PROMPT_CANARY_TOKEN=

# App URL — http://localhost:3000 for local, full URL for production
NEXT_PUBLIC_APP_URL=

# V2 — Stripe billing (uncomment when billing feature ships)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# V2 — Cloud backup (uncomment when backup feature ships)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# BACKUP_SIGNING_SECRET=
