{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "app/api/**": {
      "maxDuration": 60
    },
    "app/api/director/message/route.ts": {
      "maxDuration": 300
    },
    "app/api/director/conversation/[conversationId]/resume/route.ts": {
      "maxDuration": 300
    },
    "app/api/agent/synthesise/stream/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/director-recovery",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/purge-expired-exports",
      "schedule": "30 3 * * *"
    }
  ]
}
