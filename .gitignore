# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/test-reports
tests/.auth
tests/.screenshots
tests/results.json
test-rpc.mjs

# Director eval run artifacts (regenerable per-run JSON + comparison.md;
# fixtures/director-corpus/j5-novel/baselines.md is the curated record)
/results

# Phase 8.5 perf measurement run artifacts (regenerable JSON;
# docs/stelavox_phase8_5_perf_baseline_v1_0.md is the curated record)
docs/perf/

# Claude Code session-runtime files (per-session lock state)
.claude/scheduled_tasks.lock

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.production.local
# Cloud Supabase service-role keys for stelavox-dev / stelavox-prod.
# Lives at C:/dev/stelavox_2/.env.servicekey (parent repo root); this
# pattern also catches per-worktree copies if a smoke run leaves one.
.env.servicekey
# .env.example is intentionally NOT ignored — it is safe to commit

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local state
supabase/.branches
supabase/.temp

# Local DB snapshots — pg_dump custom-format dumps for restore-after-reset.
# Created via `docker exec supabase_db_stelavox_2 pg_dump -U postgres -Fc`.
# Never committed: contains user content + auth.users rows + secrets.
/snapshots/

# OS
Thumbs.db

.vercel
