# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
tests/.auth
tests/results.json
test-rpc.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.production.local
# .env.example is intentionally NOT ignored — it is safe to commit

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local state
supabase/.branches
supabase/.temp

# OS
Thumbs.db
